{
  "schema": "auralia-cloud-segments-v1",
  "unit": "normalized 0..1",
  "conventions": {
    "origin": "top-left of atlas",
    "uv_inset_px": 4,
    "seams": "Sample with 4px UV inset; CLAMP_TO_EDGE; no atlas-wide WRAP sampling",
    "data_r": "coverage/alpha mask",
    "data_g": "pseudo-thickness for internal lighting",
    "data_b": "small-scale erosion/detail seed for build/dissolve",
    "data_a": "unused: constant 1 inside cell",
    "color": "neutral painterly shading, multiplied/tinted at runtime by light and weather",
    "flipY": "Atlas rects use top-left pixel coordinates. Convert to Babylon UV coordinates based on texture invertY setting."
  },
